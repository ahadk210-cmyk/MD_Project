define          = -DPOSRES
integrator      = md
dt              = 0.002
nsteps          = 50000
nstxout         = 500
nstenergy       = 500
nstlog          = 500
cutoff-scheme   = Verlet
nstlist         = 10
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
vdwtype         = cutoff
DispCorr        = EnerPres
tcoupl          = V-rescale
tc-grps         = System
tau_t           = 0.1
ref_t           = 300
pcoupl          = no
pbc             = xyz
gen_vel         = yes
gen_temp        = 300
gen_seed        = -1
